# --- API ---
DATABASE_URL=postgres://jagawarga:jagawarga@localhost:5433/jagawarga
TEST_DATABASE_URL=postgres://jagawarga:jagawarga@localhost:5433/jagawarga_test
JWT_SECRET=ganti-dengan-32-byte-acak
PORT=8787
MEDIA_DIR=./data/media
PUBLIC_BASE_URL=http://localhost:8787
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Service account Firebase (JSON satu baris, base64 opsional). Kosong = push adapter log.
FCM_SERVICE_ACCOUNT_JSON=

# --- deploy produksi (docker-compose.prod.yml) ---
POSTGRES_USER=jagawarga
POSTGRES_PASSWORD=ganti-password-db-kuat
DOMAIN=jagawarga.example.com
DOCKER_NAMESPACE=jagawarga
VERSION=1.0.0
