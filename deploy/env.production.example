# Contoh environment untuk VPS (docker-compose.prod.yml).
# Salin ke `.env` di server — JANGAN commit file hasil salinan.
#
#   cp deploy/env.production.example .env
#   chmod 600 .env

# --- Database (wajib) -------------------------------------------------------
POSTGRES_USER=jagawarga
POSTGRES_DB=jagawarga
# openssl rand -base64 24
POSTGRES_PASSWORD=GANTI_PASSWORD_DB_KUAT

# --- Aplikasi (wajib) -------------------------------------------------------
# openssl rand -hex 32   (minimal 32 karakter; mengganti nilai ini = semua sesi logout)
JWT_SECRET=GANTI_DENGAN_32_BYTE_ACAK

# Domain tanpa https:// — dipakai Caddy untuk TLS otomatis (port 80 & 443 harus terbuka)
DOMAIN=jagawarga.domain.id
# Harus https dan sama dengan DOMAIN; menentukan cookie `Secure` + alamat web admin
PUBLIC_BASE_URL=https://jagawarga.domain.id
# Origin web yang diizinkan (pisahkan koma bila lebih dari satu)
CORS_ORIGINS=https://jagawarga.domain.id

# --- Image (wajib saat `make prod-up`) -------------------------------------
DOCKER_NAMESPACE=abdullahprasetio
VERSION=1.0.0

# --- Opsional ---------------------------------------------------------------
# Service account Firebase (JSON satu baris atau base64). Kosong = push nonaktif,
# inbox notifikasi tetap berjalan.
FCM_SERVICE_ACCOUNT_JSON=

# Tidak perlu diisi (dipaksa oleh docker-compose.prod.yml):
#   APP_ENV=production
#   PORT=8787
#   MEDIA_DIR=/data/media
#   DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB
